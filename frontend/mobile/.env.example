# FastAPI base URL (no trailing slash). Restart Expo after changing this file.

# Simulators only (on a real phone this points to the phone itself → "Network request failed"):
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Android emulator:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000

# Physical iPhone/Android on same Wi-Fi as your PC (use your PC's IPv4, e.g. ipconfig):
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.XXX:8000

# Production example (Render):
# EXPO_PUBLIC_API_BASE_URL=https://your-backend.onrender.com

# Backend must be: uvicorn app.main:app --reload --host 0.0.0.0 --port 8000
