{
  "expo": {
    "name": "AgrilabVision",
    "slug": "agrilabvision",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1c6b2d"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agrilabvision.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "AgrilabVision uses your location to show local weather and the map.",
        "NSPhotoLibraryUsageDescription": "Select a soil photo to analyze.",
        "NSCameraUsageDescription": "Take a soil photo to analyze with the camera."
      }
    },
    "android": {
      "package": "com.agrilabvision.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1c6b2d"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AgrilabVision uses your location for weather and the map."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to photos to analyze a soil image.",
          "cameraPermission": "Allow AgrilabVision to take a soil photo with the camera."
        }
      ]
    ]
  }
}
