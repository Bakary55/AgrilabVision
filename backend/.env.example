SECRET_KEY=replace_with_a_long_random_secret_key
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: if unset, the app uses Open-Meteo (free, no signup) for /weather/current
OPENWEATHER_API_KEY=
# Comma-separated list of allowed frontends (no wildcard in production)
# Example: https://agrilabvision-app.vercel.app,https://agrilabvision-mobile.onexpo.dev
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Optional in local dev. In cloud, set this to a managed Postgres URL.
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./agrilabvision.db
