GEMINI_API_KEY=your_gemini_api_key_here
# Optional: if unset, the app uses Open-Meteo (free, no signup) for /weather/current
OPENWEATHER_API_KEY=
# Optional in local dev. In cloud, set this to a managed Postgres URL.
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./agrilabvision.db
